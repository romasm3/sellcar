[Unit]
Description=AutoLeft — tikrina master šaką kas minutę ir diegia naujus commit'us
Documentation=file:///root/autoleft/deploy/README.md

[Timer]
# Po perkrovimo palaukiam, kol pakils tinklas ir DB
OnBootSec=3min
# Kas minutę nuo paskutinio paleidimo pabaigos. Kai naujo kodo nėra,
# ciklas yra vienas „git fetch" ir tylus išėjimas — pigu.
OnUnitActiveSec=1min
# Nedidelis išsklaidymas, kad nesikirstų su kitais darbais
RandomizedDelaySec=10s
# Praleistą (pvz. serveris buvo išjungtas) paleidžiam iškart po starto
Persistent=true
Unit=autoleft-deploy.service

[Install]
WantedBy=timers.target
